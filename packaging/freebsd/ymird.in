#!/bin/sh
#
# PROVIDE: ymird
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# The Ymir node daemon, installed by the ymir package as /usr/local/etc/rc.d/ymird.
# It runs as an unprivileged user (ymir, created when the package is installed) with its node
# folder in /var/db/ymir. Turn it on with:
#
#   sysrc ymird_enable=YES
#   service ymird start
#
# Set up the node first, as that user:  su -m ymir -c 'ymirctl --home /var/db/ymir setup'
#
# ymird_enable (bool):  Default "NO".
# ymird_user (str):     Default "ymir".
# ymird_home (str):     Default "/var/db/ymir".
# ymird_log (str):      Default "info" (YMIR_LOG).

. /etc/rc.subr

name=ymird
rcvar=ymird_enable

load_rc_config $name

: ${ymird_enable:="NO"}
: ${ymird_user:="ymir"}
: ${ymird_home:="/var/db/ymir"}
: ${ymird_log:="info"}

pidfile="/var/run/${name}.pid"
procname="%%PREFIX%%/bin/ymird"
command="/usr/sbin/daemon"
# daemon(8) restarts ymird after a crash (-r, 5 s apart) and writes its output to syslog.
command_args="-f -r -R 5 -T ${name} -P ${pidfile} -u ${ymird_user} /usr/bin/env YMIR_HOME=${ymird_home} YMIR_LOG=${ymird_log} ${procname}"
start_precmd="${name}_prestart"

ymird_prestart()
{
	install -d -o "${ymird_user}" -m 0700 "${ymird_home}"
}

run_rc_command "$1"
