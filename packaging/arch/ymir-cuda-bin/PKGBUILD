# Maintainer: Weird Brains LLC <m3talsmith@gmail.com>
# Prebuilt binaries from the GitHub release. scripts/package.py --recipe (and the release workflow)
# fill in pkgver and the sha256sums; scripts/weirdnet_release.py taur publishes this recipe to TAUR.
pkgname=ymir-cuda-bin
_ver=0.7.0
pkgver=0.7.0
pkgrel=1
pkgdesc="Private cloud of LLM models on your own machines (node daemon and CLI), llama.cpp with CUDA 13 included (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/WeirdBrains/ymir"
license=('BSD-3-Clause' 'MIT')
depends=('glibc' 'gcc-libs' 'openssl' 'brotli' 'zlib' 'zstd')
optdepends=('python-vllm: the vLLM engine (NVIDIA)')
provides=('ymir')
conflicts=('ymir' 'ymir-git' 'ymir-bin')
options=('!strip' '!debug')
source_x86_64=("ymir-cuda-${_ver}-x86_64-unknown-linux-gnu.tar.gz::${url}/releases/download/v${_ver}/ymir-cuda-${_ver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("ymir-cuda-${_ver}-aarch64-unknown-linux-gnu.tar.gz::${url}/releases/download/v${_ver}/ymir-cuda-${_ver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('682ff70dc302357c1d2fbe12c6113704e3f887a3589bf95dfc1852783b6e229f')
sha256sums_aarch64=('69a7c23d1ef1696cb51c40aff2f8fa8ad65ffaa97fe96a9665e9b3d7bb001265')

package() {
  cd "ymir-cuda-${_ver}-${CARCH}-unknown-linux-gnu"
  install -Dm755 bin/ymird "${pkgdir}/usr/bin/ymird"
  install -Dm755 bin/ymirctl "${pkgdir}/usr/bin/ymirctl"
  # The bundled llama.cpp engine; ymird finds it at ../lib/ymir/llama.cpp from /usr/bin.
  install -d "${pkgdir}/usr/lib/ymir"
  cp -a lib/ymir/llama.cpp "${pkgdir}/usr/lib/ymir/"
  install -Dm644 share/doc/ymir/README.md "${pkgdir}/usr/share/doc/ymir/README.md"
  install -Dm644 share/icons/hicolor/scalable/apps/ymir.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/ymir.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/user/ymird.service" <<'UNIT'
# Ymir node daemon, user level. Packages install this as /usr/lib/systemd/user/ymird.service.
# Enable it for your user with:  systemctl --user enable --now ymird
# Keep it running after logout:  loginctl enable-linger $USER
# (A tar.gz install writes its own unit with `ymirctl service install`.)
[Unit]
Description=Ymir node (model, inference and app roles)
Documentation=https://github.com/WeirdBrains/ymir
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/ymird
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
Environment=YMIR_LOG=info
NoNewPrivileges=yes

[Install]
WantedBy=default.target
UNIT
}
